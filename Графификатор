    def get_month_name(self):
        """Получение названия месяца на русском языке (без использования локали)"""
        months = [
            "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь",
            "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"
        ]
        
        if 1 <= self.current_month <= 12:
            return months[self.current_month - 1]
        else:
            return f"Месяц {self.current_month}"
    
    def start_auto_save(self):
        """Запуск автосохранения"""
        if self.auto_save_id:
            self.root.after_cancel(self.auto_save_id)
        
        self.auto_save_id = self.root.after(300000, self.auto_save)  # 5 минут
    
    def auto_save(self):
        """Автоматическое сохранение"""
        try:
            data = {
                "employees": self.employees,
                "shifts": self.shifts,
                "default_times": self.default_times,
                "shift_types": self.shift_types
            }
            
            with open('schedule_data_autosave.json', 'w', encoding='utf-8') as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            
            # Обновляем статус бар без показа сообщения
            current_time = datetime.now().strftime("%H:%M:%S")
            self.status_bar.config(text=f"Автосохранение: {current_time}")
            
        except Exception as e:
            print(f"Ошибка автосохранения: {e}")
        
        # Планируем следующее автосохранение
        self.start_auto_save()
    
    def lighten_color(self, hex_color):
        """Осветление цвета"""
        if not hex_color.startswith('#'):
            return hex_color
        
        try:
            r = int(hex_color[1:3], 16)
            g = int(hex_color[3:5], 16)
            b = int(hex_color[5:7], 16)
            
            r = min(255, int(r * 1.2))
            g = min(255, int(g * 1.2))
            b = min(255, int(b * 1.2))
            
            return f'#{r:02x}{g:02x}{b:02x}'
        except:
            return hex_color

