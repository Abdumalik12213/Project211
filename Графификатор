    def show_hour_statistics(self):
        """Показать статистику по отработанным часам"""
        if not self.employees:
            messagebox.showinfo("Статистика", "Нет данных о сотрудниках", parent=self.root)
            return
        
        stats = {}
        
        for employee in self.employees:
            employee_shifts = [s for s in self.shifts if s["employee_id"] == employee["id"]]
            total_hours = 0
            
            for shift in employee_shifts:
                try:
                    start_time = shift.get("start_time", "00:00")
                    end_time = shift.get("end_time", "00:00")
                    
                    # Пропускаем выходные
                    if start_time == "00:00" and end_time == "00:00":
                        continue
                    
                    start_h, start_m = map(int, start_time.split(":"))
                    end_h, end_m = map(int, end_time.split(":"))
                    
                    # Учитываем смены, переходящие через полночь
                    if end_h < start_h or (end_h == start_h and end_m < start_m):
                        end_h += 24
                    
                    hours = (end_h - start_h) + (end_m - start_m) / 60
                    total_hours += hours
                except:
                    continue
            
            stats[employee["name"]] = total_hours
        
        # Формируем текст статистики
        if not any(hours > 0 for hours in stats.values()):
            messagebox.showinfo("Статистика по часам", 
                              "Нет данных о рабочих часах", parent=self.root)
            return
        
        stats_text = "📊 Статистика по часам:\n\n"
        for name, hours in sorted(stats.items(), key=lambda x: x[1], reverse=True):
            if hours > 0:
                stats_text += f"• {name}: {hours:.1f} часов\n"
        
        # Добавляем общую сумму
        total_hours = sum(stats.values())
        stats_text += f"\n📈 Всего часов: {total_hours:.1f}"
        stats_text += f"\n📊 Среднее: {total_hours/len(self.employees):.1f} часов на сотрудника"
        
        messagebox.showinfo("Статистика по часам", stats_text, parent=self.root)
    
    def show_statistics(self):
        """Показать статистику"""
        total_shifts = len(self.shifts)
        month_shifts = sum(1 for s in self.shifts 
                          if datetime.strptime(s["date"], "%Y-%m-%d").year == self.current_year and
                          datetime.strptime(s["date"], "%Y-%m-%d").month == self.current_month)
        
        # Считаем смены по типам
        shift_counts = {}
        for shift in self.shifts:
            shift_type = shift.get("shift_type", "Неизвестно")
            shift_counts[shift_type] = shift_counts.get(shift_type, 0) + 1
        
        month_name_rus = self.get_month_name()
        
        stats_text = f"""
📊 Статистика системы:
        
👥 Работников: {len(self.employees)}
📅 Всего смен: {total_shifts}
📆 Смен в текущем месяце: {month_shifts}
"""
        if self.employees:
            avg_shifts = total_shifts / len(self.employees)
            stats_text += f"📈 Среднее смен на работника: {avg_shifts:.1f}\n"
        
        stats_text += f"""
📅 Текущий месяц: {month_name_rus} {self.current_year}
        
📋 Распределение смен по типам:
"""
        for shift_type, count in shift_counts.items():
            stats_text += f"  • {shift_type}: {count}\n"
        
        stats_text += f"""
🔄 Последнее обновление: {datetime.now().strftime('%d.%m.%Y %H:%M')}
    """
        
        messagebox.showinfo("📈 Статистика", stats_text.strip(), parent=self.root)
    
