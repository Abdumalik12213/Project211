    def update_month_label(self):
        """Обновление метки текущего месяца"""
        month_name_rus = self.get_month_name()
        self.month_label.config(text=f"{month_name_rus} {self.current_year}")
        if hasattr(self, 'schedule_title'):
            self.schedule_title.config(text=f"График смен на {month_name_rus} {self.current_year}")
        
    def update_schedule_display(self):
        """Обновление отображения графика на текущий месяц"""
        # Обновляем метку месяца
        self.update_month_label()
        
        # Очищаем таблицу
        for item in self.schedule_tree.get_children():
            self.schedule_tree.delete(item)
        
        # Получаем количество дней в месяце
        _, num_days = monthrange(self.current_year, self.current_month)
        
        # Обновляем значения дней в Combobox
        self.day_cb['values'] = list(range(1, num_days + 1))
        
        # Настраиваем колонки таблицы
        columns = ['employee'] + [f'day_{i}' for i in range(1, num_days + 1)]
        self.schedule_tree['columns'] = tuple(columns)
        
        # Скрываем первую колонку
        self.schedule_tree.column('#0', width=0, stretch=tk.NO)
        
        # Настраиваем ширину колонки с именем
        self.schedule_tree.column('employee', width=180, anchor=tk.W, minwidth=150)
        
        # Настраиваем колонки дней
        for i in range(1, num_days + 1):
            self.schedule_tree.column(f'day_{i}', width=110, anchor=tk.CENTER, minwidth=100, stretch=True)
        
        # Заголовки колонок
        self.schedule_tree.heading('employee', text='Работник', anchor=tk.W)
        
        # Русские сокращения дней недели
        russian_days = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]
        
        # Заполняем заголовки дней
        for i in range(1, num_days + 1):
            day_date = date(self.current_year, self.current_month, i)
            
            # Получаем номер дня недели (0=понедельник, 6=воскресенье)
            day_of_week = day_date.weekday()
            
            # Формируем заголовок с русским днем недели
            day_header = f"{i}\n{russian_days[day_of_week]}"
            
            # Цвет выходных дней
            if day_date.weekday() >= 5:  # Суббота и воскресенье
                day_header = f"📅 {i}\n{russian_days[day_of_week]}"
            
            self.schedule_tree.heading(f'day_{i}', text=day_header, anchor=tk.CENTER)
        
        # Сохраняем даты для справки
        self.current_month_dates = [date(self.current_year, self.current_month, i) 
                                   for i in range(1, num_days + 1)]
        
        # Создаем словарь для быстрого доступа к сменам
        shifts_dict = {}
        for shift in self.shifts:
            try:
                shift_date = datetime.strptime(shift["date"], "%Y-%m-%d").date()
                if shift_date.year == self.current_year and shift_date.month == self.current_month:
                    key = (shift["employee_name"], shift_date.day)
                    
                    # Получаем цвет для типа смены
                    shift_type = shift.get("shift_type", "")
                    color = self.default_times.get(shift_type, {}).get('color', '#95a5a6')
                    
                    # Форматируем отображение смены
                    if shift.get("start_time") and shift.get("end_time"):
                        if shift["start_time"] == "00:00" and shift["end_time"] == "00:00":
                            shift_display = shift_type
                        else:
                            shift_display = f"{shift_type}\n{shift['start_time']}-{shift['end_time']}"
                    else:
                        shift_display = shift_type
                    
                    shifts_dict[key] = (shift_display, color)
            except ValueError:
                continue
        
        # Добавляем строки для каждого работника
        for idx, employee in enumerate(self.employees):
            # Получаем смены на текущий месяц
            month_shifts = []
            for day in range(1, num_days + 1):
                shift_info = shifts_dict.get((employee["name"], day), ("", "#ffffff"))
                month_shifts.append(shift_info[0])
            
            # Добавляем строку в таблицу
            values = (employee["name"],) + tuple(month_shifts)
            
            item = self.schedule_tree.insert('', tk.END, values=values)
            
            # Раскрашиваем ячейки
            for i, day in enumerate(range(1, num_days + 1)):
                shift_info = shifts_dict.get((employee["name"], day), ("", "#ffffff"))
                if shift_info[0]:  # Если есть смена
                    self.schedule_tree.set(item, f'day_{day}', shift_info[0])
                    # Создаем тег с цветом если его нет
                    tag_name = f'color_{shift_info[1].replace("#", "")}'
                    if not self.schedule_tree.tag_configure(tag_name):
                        self.schedule_tree.tag_configure(tag_name, 
                                                        background=shift_info[1],
                                                        foreground='white')
                    # Применяем тег к ячейке
                    self.schedule_tree.item(item, tags=(tag_name,))
        
        # Обновляем список работников
        self.update_employees_list()
        
        # Обновляем статистику
        self.update_statistics()
        
        # Обновляем статус бар
        month_name_rus = self.get_month_name()
        self.status_bar.config(text=f"График обновлен: {month_name_rus} {self.current_year}")
    
    def update_employees_list(self):
        """Обновление списка работников"""
        # Обновляем Combobox
        self.employee_cb['values'] = [emp["name"] for emp in self.employees]
        
        # Обновляем Treeview с работниками
        for item in self.employees_tree.get_children():
            self.employees_tree.delete(item)
        
        for emp in self.employees:
            # Считаем количество смен у работника
            shift_count = sum(1 for s in self.shifts if s["employee_id"] == emp["id"])
            self.employees_tree.insert('', tk.END, values=(emp["id"], emp["name"], shift_count))
    
    def update_statistics(self):
        """Обновление статистики"""
        total_shifts = len(self.shifts)
        month_shifts = sum(1 for s in self.shifts 
                          if datetime.strptime(s["date"], "%Y-%m-%d").year == self.current_year and
                          datetime.strptime(s["date"], "%Y-%m-%d").month == self.current_month)
        
        self.stats_label.config(text=f"Работников: {len(self.employees)} | Всего смен: {total_shifts} | Смен в месяце: {month_shifts}")
    
    def add_employee(self):
        """Добавление нового работника"""
        name = self.employee_name.get().strip()
        
        if not name:
            messagebox.showwarning("Внимание", "Введите ФИО работника", parent=self.root)
            return
        
        if any(emp["name"] == name for emp in self.employees):
            messagebox.showwarning("Внимание", "Работник с таким ФИО уже существует", parent=self.root)
            return
        
        employee_id = len(self.employees) + 1
        self.employees.append({
            "id": employee_id,
            "name": name
        })
        
        self.employee_name.delete(0, tk.END)
        self.update_schedule_display()
        
        messagebox.showinfo("Успех", f"Работник {name} добавлен", parent=self.root)
    
    def assign_shift(self):
        """Назначение смены работнику"""
        employee_name = self.employee_var.get()
        day = self.day_var.get()
        shift_full = self.shift_var.get()
        
        if not all([employee_name, day, shift_full]):
            messagebox.showwarning("Внимание", "Заполните все поля", parent=self.root)
            return
        
        try:
            shift_date = date(self.current_year, self.current_month, day)
            date_str = shift_date.strftime("%Y-%m-%d")
        except ValueError as e:
            messagebox.showwarning("Внимание", f"Неверная дата: {str(e)}", parent=self.root)
            return
        
        employee = next((emp for emp in self.employees if emp["name"] == employee_name), None)
        if not employee:
            messagebox.showwarning("Внимание", "Работник не найден", parent=self.root)
            return
        
        # Извлекаем время
        shift_type = shift_full
        start_time = f"{self.start_hour_var.get()}:{self.start_minute_var.get()}"
        end_time = f"{self.end_hour_var.get()}:{self.end_minute_var.get()}"
        
        if '(' in shift_full and ')' in shift_full:
            shift_type = shift_full.split('(')[0].strip()
        
        # Удаляем существующую смену
        self.shifts = [s for s in self.shifts if not (s["employee_id"] == employee["id"] and s["date"] == date_str)]
        
        # Добавляем новую смену
        self.shifts.append({
            "employee_id": employee["id"],
            "employee_name": employee_name,
            "date": date_str,
            "shift": shift_full,
            "shift_type": shift_type,
            "start_time": start_time,
            "end_time": end_time
        })
        
        self.update_schedule_display()
        
        messagebox.showinfo("Успех", f"Смена назначена: {employee_name} - {shift_date.strftime('%d.%m.%Y')}", parent=self.root)
    
    def copy_shift(self):
        """Копирование смены на другой день"""
        if not all([self.employee_var.get(), self.day_var.get(), self.shift_var.get()]):
            messagebox.showwarning("Внимание", "Заполните все поля для копирования", parent=self.root)
            return
        
        # Создаем диалог выбора дня для копирования
        copy_window = tk.Toplevel(self.root)
        copy_window.title("Копировать смену")
        copy_window.geometry("300x200")
        copy_window.transient(self.root)
        copy_window.grab_set()
        
        ttk.Label(copy_window, text="Выберите день для копирования:", 
                 font=('Segoe UI', 11)).pack(pady=20)
        
        day_var = tk.IntVar(value=self.day_var.get())
        
        # Получаем количество дней в текущем месяце
        _, num_days = monthrange(self.current_year, self.current_month)
        
        days_combo = ttk.Combobox(copy_window, textvariable=day_var,
                                 values=list(range(1, num_days + 1)), state="readonly")
        days_combo.pack(pady=10)
        
        def do_copy():
            try:
                original_day = self.day_var.get()
                target_day = day_var.get()
                
                if original_day == target_day:
                    messagebox.showwarning("Внимание", "Выберите другой день", parent=copy_window)
                    return
                
                # Сохраняем оригинальные значения
                original_employee = self.employee_var.get()
                original_shift = self.shift_var.get()
                original_start_hour = self.start_hour_var.get()
                original_start_minute = self.start_minute_var.get()
                original_end_hour = self.end_hour_var.get()
                original_end_minute = self.end_minute_var.get()
                
                # Устанавливаем целевой день
                self.day_var.set(target_day)
                
                # Вызываем assign_shift для копирования
                self.assign_shift()
                
                # Возвращаем оригинальные значения
                self.day_var.set(original_day)
                self.employee_var.set(original_employee)
                self.shift_var.set(original_shift)
                self.start_hour_var.set(original_start_hour)
                self.start_minute_var.set(original_start_minute)
                self.end_hour_var.set(original_end_hour)
                self.end_minute_var.set(original_end_minute)
                
                copy_window.destroy()
                messagebox.showinfo("Успех", f"Смена скопирована на {target_day} число", 
                                  parent=self.root)
            except Exception as e:
                messagebox.showerror("Ошибка", str(e), parent=copy_window)
        
        ttk.Button(copy_window, text="Копировать", 
                  command=do_copy, style='Success.TButton').pack(pady=20)
    
    def on_shift_type_selected(self, event=None):
        """При выборе типа смены устанавливаем время по умолчанию"""
        shift_type = self.shift_var.get()
        if shift_type:
            base_name = shift_type.split('(')[0].strip()
            
            if base_name in self.default_times:
                start_time = self.default_times[base_name]["start"]
                end_time = self.default_times[base_name]["end"]
                
                if start_time != "00:00" or end_time != "00:00":
                    start_hour, start_minute = start_time.split(":")
                    end_hour, end_minute = end_time.split(":")
                    
                    self.start_hour_var.set(start_hour)
                    self.start_minute_var.set(start_minute)
                    self.end_hour_var.set(end_hour)
                    self.end_minute_var.set(end_minute)
    
