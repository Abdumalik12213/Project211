    def create_legend(self, parent):
        """Создание улучшенной легенды типов смен"""
        legend_frame = ttk.LabelFrame(parent, text="Легенда смен", padding=10)
        legend_frame.pack(fill=tk.X, padx=20, pady=(0, 10))
        
        legend_container = ttk.Frame(legend_frame)
        legend_container.pack(fill=tk.X)
        
        row, col = 0, 0
        for shift_name, settings in self.default_times.items():
            color = settings.get('color', '#95a5a6')
            
            item_frame = ttk.Frame(legend_container)
            item_frame.grid(row=row, column=col, padx=10, pady=5, sticky=tk.W)
            
            # Цветной квадрат
            color_label = tk.Label(item_frame, text="   ", bg=color, 
                                  font=('Segoe UI', 8), relief=tk.RAISED, bd=1)
            color_label.pack(side=tk.LEFT, padx=(0, 5))
            
            # Название и время
            if settings["start"] != "00:00" or settings["end"] != "00:00":
                text = f"{shift_name} ({settings['start']}-{settings['end']})"
            else:
                text = shift_name
                
            tk.Label(item_frame, text=text, font=('Segoe UI', 9)).pack(side=tk.LEFT)
            
            col += 1
            if col > 2:  # 3 колонки
                col = 0
                row += 1
        
    def create_schedule_table(self, parent):
        """Создание таблицы с графиком смен - улучшенная версия"""
        # Фрейм для таблицы с тенями
        table_container = tk.Frame(parent, bg=self.colors['border'])
        table_container.pack(fill=tk.BOTH, expand=True)
        
        # Вертикальный скроллбар
        vsb = ttk.Scrollbar(table_container)
        vsb.pack(side=tk.RIGHT, fill=tk.Y)
        
        # Горизонтальный скроллбар
        hsb = ttk.Scrollbar(table_container, orient=tk.HORIZONTAL)
        hsb.pack(side=tk.BOTTOM, fill=tk.X)
        
        # Создание таблицы с улучшенным видом
        self.schedule_tree = ttk.Treeview(table_container,
                                         yscrollcommand=vsb.set,
                                         xscrollcommand=hsb.set,
                                         selectmode="browse")
        
        # Настройка скроллбаров
        vsb.config(command=self.schedule_tree.yview)
        hsb.config(command=self.schedule_tree.xview)
        
        self.schedule_tree.pack(fill=tk.BOTH, expand=True)
        
        # Кастомный стиль для Treeview
        style = ttk.Style()
        style.configure("Custom.Treeview",
                       background=self.colors['card'],
                       foreground=self.colors['dark'],
                       rowheight=45,
                       fieldbackground=self.colors['card'],
                       font=('Segoe UI', 10))
        
        style.configure("Custom.Treeview.Heading",
                       font=('Segoe UI', 11, 'bold'),
                       background=self.colors['primary'],
                       foreground='white')
        
        style.map("Custom.Treeview",
                 background=[('selected', self.colors['secondary'])])
        
        self.schedule_tree.configure(style="Custom.Treeview", height=15)
        
    def create_status_bar(self, parent):
        """Создание статус-бара"""
        status_frame = ttk.Frame(parent, relief=tk.SUNKEN)
