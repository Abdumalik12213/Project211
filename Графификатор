    def search_employee(self):
        """Поиск сотрудника в графике"""
        search_term = self.search_var.get().strip().lower()
        if not search_term:
            return
        
        # Снимаем выделение со всех строк
        for item in self.schedule_tree.selection():
            self.schedule_tree.selection_remove(item)
        
        # Ищем совпадения
        found = False
        for item in self.schedule_tree.get_children():
            employee_name = self.schedule_tree.item(item, 'values')[0].lower()
            if search_term in employee_name:
                self.schedule_tree.selection_add(item)
                self.schedule_tree.see(item)
                found = True
                break
        
        if not found:
            self.status_bar.config(text=f"Сотрудник '{search_term}' не найден")
        else:
            self.status_bar.config(text=f"Найден сотрудник: {search_term}")
    
    def delete_employee(self):
        """Удаление выбранного работника"""
        selection = self.employees_tree.selection()
        if not selection:
            messagebox.showwarning("Внимание", "Выберите работника для удаления", parent=self.root)
            return
        
        item = self.employees_tree.item(selection[0])
        employee_id = item['values'][0]
        employee_name = item['values'][1]
        
        if messagebox.askyesno("Подтверждение", f"Удалить работника {employee_name}?\nВсе его смены также будут удалены.", parent=self.root):
            # Удаляем работника
            self.employees = [e for e in self.employees if e["id"] != employee_id]
            
            # Удаляем все смены работника
            self.shifts = [s for s in self.shifts if s["employee_id"] != employee_id]
            
            self.update_schedule_display()
            messagebox.showinfo("Успех", f"Работник {employee_name} удален", parent=self.root)
    
    def delete_shift(self):
        """Удаление смены"""
        if not all([self.employee_var.get(), self.day_var.get()]):
            messagebox.showwarning("Внимание", "Выберите работника и день для удаления смены", parent=self.root)
            return
        
        employee_name = self.employee_var.get()
        day = self.day_var.get()
        
        employee = next((emp for emp in self.employees if emp["name"] == employee_name), None)
        if not employee:
            messagebox.showwarning("Внимание", "Работник не найден", parent=self.root)
            return
        
        try:
            shift_date = date(self.current_year, self.current_month, day)
            date_str = shift_date.strftime("%Y-%m-%d")
        except ValueError:
            messagebox.showwarning("Внимание", "Неверный день", parent=self.root)
            return
        
        initial_count = len(self.shifts)
        self.shifts = [s for s in self.shifts if not (s["employee_id"] == employee["id"] and s["date"] == date_str)]
        
        if len(self.shifts) < initial_count:
            self.update_schedule_display()
            messagebox.showinfo("Успех", f"Смена удалена: {employee_name} - {shift_date.strftime('%d.%m.%Y')}", parent=self.root)
        else:
            messagebox.showinfo("Информация", "Смена не найдена", parent=self.root)
    
    def prev_year(self):
        """Переход к предыдущему году"""
        self.current_year -= 1
        self.update_schedule_display()
    
    def next_year(self):
        """Переход к следующему году"""
        self.current_year += 1
        self.update_schedule_display()
    
    def prev_month(self):
        """Переход к предыдущему месяцу"""
        if self.current_month == 1:
            self.current_month = 12
            self.current_year -= 1
        else:
            self.current_month -= 1
        
        self.update_schedule_display()
    
    def next_month(self):
        """Переход к следующему месяцу"""
        if self.current_month == 12:
            self.current_month = 1
            self.current_year += 1
        else:
            self.current_month += 1
        
        self.update_schedule_display()
    
    def today_month(self):
        """Переход к текущему месяцу"""
        self.current_date = datetime.now()
        self.current_year = self.current_date.year
        self.current_month = self.current_date.month
        
        self.update_schedule_display()
    
    def generate_month(self):
        """Генерация смен на месяц"""
        if not self.employees:
            messagebox.showwarning("Внимание", "Сначала добавьте работников", parent=self.root)
            return
        
        _, num_days = monthrange(self.current_year, self.current_month)
        month_name_rus = self.get_month_name()
        
        if messagebox.askyesno("Подтверждение", 
                              f"Сгенерировать смены на {month_name_rus} ({num_days} дней)?\nСуществующие смены будут перезаписаны.", 
                              parent=self.root):
            
            # Генерация смен по циклу
            for day in range(1, num_days + 1):
                date_obj = date(self.current_year, self.current_month, day)
                date_str = date_obj.strftime("%Y-%m-%d")
                
                # Выбираем тип смены по порядку
                shift_index = (day - 1) % len(self.shift_types)
                
                for emp in self.employees:
                    # Удаляем существующую смену
                    self.shifts = [s for s in self.shifts if not (s["employee_id"] == emp["id"] and s["date"] == date_str)]
                    
                    # Получаем тип смены
                    shift_full = self.shift_types[shift_index]
                    shift_type = shift_full.split('(')[0].strip() if '(' in shift_full else shift_full
                    
                    # Получаем время из настроек
                    start_time = self.default_times.get(shift_type, {}).get("start", "08:00")
                    end_time = self.default_times.get(shift_type, {}).get("end", "16:00")
                    
                    # Добавляем новую смену
                    self.shifts.append({
                        "employee_id": emp["id"],
                        "employee_name": emp["name"],
                        "date": date_str,
                        "shift": shift_full,
                        "shift_type": shift_type,
                        "start_time": start_time,
                        "end_time": end_time
                    })
            
            self.update_schedule_display()
            messagebox.showinfo("Успех", f"График смен на {month_name_rus} сгенерирован", parent=self.root)
    
    def clear_month(self):
        """Очистка всех смен текущего месяца"""
        month_name_rus = self.get_month_name()
        
        if messagebox.askyesno("Подтверждение", 
                              f"Очистить все смены за {month_name_rus} {self.current_year}?", 
                              parent=self.root):
            initial_count = len(self.shifts)
            self.shifts = [s for s in self.shifts 
                          if not (datetime.strptime(s["date"], "%Y-%m-%d").year == self.current_year and 
                                  datetime.strptime(s["date"], "%Y-%m-%d").month == self.current_month)]
            
            removed = initial_count - len(self.shifts)
            self.update_schedule_display()
            
            messagebox.showinfo("Успех", f"Удалено {removed} смен", parent=self.root)
    
    def save_data(self):
        """Сохранение данных"""
        data = {
            "employees": self.employees,
            "shifts": self.shifts,
            "default_times": self.default_times,
            "shift_types": self.shift_types
        }
        
        try:
            with open('schedule_data_modern.json', 'w', encoding='utf-8') as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            self.status_bar.config(text="Данные сохранены")
            messagebox.showinfo("Успех", "Данные успешно сохранены", parent=self.root)
        except Exception as e:
            messagebox.showerror("Ошибка", f"Не удалось сохранить данные: {str(e)}", parent=self.root)
    
    def load_data(self):
        """Загрузка данных"""
        if os.path.exists('schedule_data_modern.json'):
            try:
                with open('schedule_data_modern.json', 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    self.employees = data.get("employees", [])
                    self.shifts = data.get("shifts", [])
                    self.default_times = data.get("default_times", self.default_times)
                    self.shift_types = data.get("shift_types", self.shift_types)
            except Exception as e:
                messagebox.showwarning("Внимание", f"Не удалось загрузить данные: {str(e)}", parent=self.root)
    
    def export_to_txt(self):
        """Экспорт в TXT"""
        try:
            month_name_rus = self.get_month_name()
            filename = f"график_{month_name_rus}_{self.current_year}.txt"
            
            # Русские названия дней недели
            russian_days_full = ["Понедельник", "Вторник", "Среда", "Четверг", 
                                "Пятница", "Суббота", "Воскресенье"]
            
            with open(filename, 'w', encoding='utf-8') as f:
                f.write("=" * 60 + "\n")
                f.write(f"ГРАФИК СМЕН НА {month_name_rus.upper()} {self.current_year}\n")
                f.write("=" * 60 + "\n\n")
                
                # Информация о работниках
                f.write("СПИСОК РАБОТНИКОВ:\n")
                f.write("-" * 40 + "\n")
                for emp in self.employees:
                    f.write(f"{emp['id']}. {emp['name']}\n")
                f.write("\n")
                
                # График по дням
                f.write("ГРАФИК ПО ДНЯМ:\n")
                f.write("=" * 60 + "\n")
                
                # Получаем количество дней в месяце
                _, num_days = monthrange(self.current_year, self.current_month)
                
                for day in range(1, num_days + 1):
                    day_date = date(self.current_year, self.current_month, day)
                    day_of_week = day_date.weekday()
                    day_name = russian_days_full[day_of_week]
                    f.write(f"\n{day_date.strftime('%d.%m.%Y')} ({day_name}):\n")
                    f.write("-" * 40 + "\n")
                    
                    # Смены на этот день
                    day_shifts = []
                    for shift in self.shifts:
                        try:
                            shift_date = datetime.strptime(shift["date"], "%Y-%m-%d").date()
                            if shift_date == day_date:
                                time_info = ""
                                if shift.get("start_time") and shift.get("end_time"):
                                    if shift["start_time"] != "00:00" or shift["end_time"] != "00:00":
                                        time_info = f" ({shift['start_time']}-{shift['end_time']})"
                                
                                day_shifts.append(f"  {shift['employee_name']}: {shift.get('shift_type', '')}{time_info}")
                        except ValueError:
                            continue
                    
                    if day_shifts:
                        for shift_info in day_shifts:
                            f.write(shift_info + "\n")
                    else:
                        f.write("  Смен не назначено\n")
                
                # Сводная информация
                f.write("\n" + "=" * 60 + "\n")
                f.write("СВОДКА:\n")
                f.write("=" * 60 + "\n\n")
                f.write(f"Всего работников: {len(self.employees)}\n")
                f.write(f"Всего смен: {len(self.shifts)}\n")
                f.write(f"Экспорт выполнен: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}\n")
                f.write("=" * 60 + "\n")
                
            self.status_bar.config(text=f"Экспортировано в {filename}")
            messagebox.showinfo("Успех", f"График экспортирован в {filename}", parent=self.root)
            
            # Пытаемся открыть файл
            try:
                os.startfile(filename)
            except:
                pass
                
        except Exception as e:
            messagebox.showerror("Ошибка", f"Не удалось экспортировать: {str(e)}", parent=self.root)
    
