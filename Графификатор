    def save_time_settings(self, window):
        """Сохранение настроек времени"""
        for shift_name in self.default_times.keys():
            start_hour_var = getattr(self, f"time_{shift_name}_start_hour")
            start_minute_var = getattr(self, f"time_{shift_name}_start_minute")
            end_hour_var = getattr(self, f"time_{shift_name}_end_hour")
            end_minute_var = getattr(self, f"time_{shift_name}_end_minute")
            
            self.default_times[shift_name]["start"] = f"{start_hour_var.get()}:{start_minute_var.get()}"
            self.default_times[shift_name]["end"] = f"{end_hour_var.get()}:{end_minute_var.get()}"
        
        # Обновляем список типов смен
        self.shift_types = []
        for shift_name, settings in self.default_times.items():
            if settings["start"] == "00:00" and settings["end"] == "00:00":
                self.shift_types.append(shift_name)
            else:
                self.shift_types.append(f"{shift_name} ({settings['start']}-{settings['end']})")
        
        self.shift_cb['values'] = self.shift_types
        
        window.destroy()
        self.update_schedule_display()
        messagebox.showinfo("Успех", "Настройки времени сохранены", parent=self.root)
    
